{
  "expo": {
    "name": "Finni",
    "slug": "heyfinni",
    "owner": "heyfinniai",
    "version": "1.0.0",
    "description": "AI-powered personal finance assistant. Track expenses, manage budgets, and reach your financial goals.",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0F1E"
    },
    "ios": {
      "supportsTablet": true
    },
    "scheme": "finni-app",
    "newArchEnabled": true,
    "android": {
      "package": "com.finni.app",
      "versionCode": 2,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#6366F1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "extra": {
      "eas": {
        "projectId": "e321e1be-455d-404c-95a9-aa6c02be4bd6"
      },
      "privacyPolicyUrl": "https://www.heyfinni.com/privacy-policy",
      "dataDeletionUrl": "https://www.heyfinni.com/data-deletion",
      "supportEmail": "support@heyfinni.com"
    },
    "plugins": [
      "expo-localization"
    ]
  }
}
