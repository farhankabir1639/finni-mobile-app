{
  "expo": {
    "name": "Finni",
    "slug": "heyfinni",
    "owner": "farhankabir1111",
    "version": "1.0.0",
    "description": "AI-powered personal finance assistant. Track expenses, manage budgets, and reach your financial goals.",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0F1E"
    },
    "ios": {
      "bundleIdentifier": "com.finni.app",
      "supportsTablet": true
    },
    "scheme": "finni-app",
    "newArchEnabled": true,
    "android": {
      "package": "com.finni.app",
      "versionCode": 27,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#6366F1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "softwareKeyboardLayoutMode": "pan"
    },
    "extra": {
      "eas": {
        "projectId": "ff04cf2f-5e5f-4e65-bfc8-3ce30d091e10"
      },
      "privacyPolicyUrl": "https://www.heyfinni.com/privacy-policy",
      "termsOfServiceUrl": "https://www.heyfinni.com/terms",
      "dataDeletionUrl": "https://www.heyfinni.com/data-deletion",
      "supportEmail": "support@heyfinni.com"
    },
    "plugins": [
      "expo-localization",
      "expo-web-browser",
      "./plugins/strip-media-permissions",
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0A0F1E",
          "sounds": []
        }
      ],
      [
        "@sentry/react-native",
        {
          "organization": "finni-vb",
          "project": "react-native"
        }
      ]
    ]
  }
}
