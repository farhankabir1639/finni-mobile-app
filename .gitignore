# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local credentials — contains keystore passwords
credentials.json

# local env files — NEVER commit real secrets
.env
.env.local
.env*.local

# EAS — use EAS Secrets for CI/CD, not plaintext keys in this file
# eas.json is committed but must only contain $VAR references, never raw keys

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
